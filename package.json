{
  "name": "paperclip-goose-adapter",
  "version": "0.1.0",
  "description": "External Paperclip adapter override that runs Goose over SSH under the grok_local adapter type",
  "license": "MIT",
  "type": "module",
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "files": [
    "dist",
    "scripts/motor-bonus-daily.py",
    "scripts/read-instructions.py"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.916.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
